{
	"name": "@clauscode/nestjs-configuration",
	"version": "1.0.0",
	"description": "A lightweight library for validating and type-safe dotenv configuration.",
	"type": "commonjs",
	"author": {
		"name": "Николай Матвеев",
		"email": "claus-code@yandex.com"
	},
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"check:ci": "biome ci .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^4.0.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.0",
		"typescript": "^5.8.0",
		"vitest": "^5.0.4",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.0.0 || ^11.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0",
		"@nestjs/config": "^4.0.0",
		"reflect-metadata": "^0.1.13 || ^0.2.0",
		"rxjs": "^7.1.0",
		"zod": "^4.0.0"
	}
}
