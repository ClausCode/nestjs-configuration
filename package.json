{
	"name": "@clauscode/nestjs-configuration",
	"version": "0.0.1",
	"description": "A lightweight library for validating and type-safe dotenv configuration.",
	"type": "commonjs",
	"author": {
		"name": "Николай Матвеев",
		"email": "claus-code@yandex.com"
	},
	"license": "ISC",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"check:ci": "biome ci .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@nestjs/testing": "^12.1.3",
		"@types/bun": "1.4.3",
		"vitest": "^5.0.4"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"@nestjs/common": "^12.1.3",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.1.3",
		"reflect-metadata": "^0.2.2",
		"txjs": "^0.1.1",
		"zod": "^4.6.7"
	}
}
